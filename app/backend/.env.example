DATABASE_URL=mysql+aiomysql://printshop:printshop@localhost:3306/printshop
CORS_ORIGINS=http://localhost:5173

# 작업요청(SQS) — 비워두면 produce/consume이 조용히 비활성화된다.
AWS_REGION=ap-northeast-2
COMMAND_QUEUE_URL=
EVENT_QUEUE_URL=

# 실물 로봇 조인트 각도 실시간 피드(/ws/robot-state) 인증 토큰.
# 비워두면 이 엔드포인트는 모든 연결을 거부한다(fail-closed) — 위 두 값과
# 반대로, 여기는 "비어있으면 기능 끔"이 아니라 "비어있으면 거부"다.
ROBOT_STATE_WS_TOKEN=
