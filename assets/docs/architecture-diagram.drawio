<mxfile host="app.diagrams.net" agent="claude-code">
  <diagram name="GenghisKan Architecture" id="genghiskan-arch">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" value="GenghisKan 주문&#xa;로봇 처리 아키텍처" vertex="1">
          <mxGeometry x="40" y="0" width="1700" height="36" as="geometry" />
        </mxCell>

        <!-- Headers -->
        <mxCell id="hdrF" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#36597d;fontColor=#ffffff;fontStyle=1;fontSize=13;" value="프론트엔드 (React + TS + Vite)" vertex="1">
          <mxGeometry x="40" y="44" width="260" height="28" as="geometry" />
        </mxCell>
        <mxCell id="hdrB" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#4f7a3d;fontColor=#ffffff;fontStyle=1;fontSize=13;" value="백엔드 (FastAPI, 계층형+DDD)" vertex="1">
          <mxGeometry x="380" y="44" width="340" height="28" as="geometry" />
        </mxCell>
        <mxCell id="hdrS" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=#996f00;fontColor=#ffffff;fontStyle=1;fontSize=13;" value="AWS SQS" vertex="1">
          <mxGeometry x="800" y="44" width="220" height="28" as="geometry" />
        </mxCell>
        <mxCell id="hdrR" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#9673a6;strokeColor=#6f527e;fontColor=#ffffff;fontStyle=1;fontSize=13;" value="ROS 2 워크스페이스 (app/ros2_ws)" vertex="1">
          <mxGeometry x="1100" y="44" width="300" height="28" as="geometry" />
        </mxCell>
        <mxCell id="hdrH" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#666666;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=13;" value="하드웨어" vertex="1">
          <mxGeometry x="1480" y="44" width="240" height="28" as="geometry" />
        </mxCell>

        <!-- Frontend nodes (2 boxes only, to avoid a 3rd box forcing edges through others) -->
        <mxCell id="f1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="Web UI (키오스크)&#xa;(Pages·Organisms·Atoms,&#xa;3D Viewer: DoosanArmViewer)" vertex="1">
          <mxGeometry x="40" y="90" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="API / 상태 클라이언트&#xa;lib/api.ts (REST) +&#xa;useLiveState (WebSocket)" vertex="1">
          <mxGeometry x="40" y="280" width="260" height="90" as="geometry" />
        </mxCell>

        <!-- Backend nodes: single vertical chain Router -> Service -> SQS-service, then Service branches to DB,
             and SQS-service branches to WS Router. No box sits "in front of" a longer edge. -->
        <mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="API Routers&#xa;work_requests · orders · teaching_pendant&#xa;board_stock · stats · state · health" vertex="1">
          <mxGeometry x="380" y="90" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="Service Layer&#xa;OrderService · WorkRequestService&#xa;TeachingPendantService · StateService 등" vertex="1">
          <mxGeometry x="380" y="195" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="SQS Producer / Consumer /&#xa;Monitor Service" vertex="1">
          <mxGeometry x="380" y="290" width="340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="WS Router — /ws/client&#xa;(push-only)" vertex="1">
          <mxGeometry x="380" y="380" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b6" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="MySQL&#xa;(Repository → DB)" vertex="1">
          <mxGeometry x="560" y="375" width="160" height="75" as="geometry" />
        </mxCell>

        <!-- SQS nodes -->
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="robot-commands.fifo&#xa;(LOAD/UNLOAD/JOG/GRIPPER)" vertex="1">
          <mxGeometry x="800" y="280" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="robot-commands-stop&#xa;(Standard, STOP 전용 채널)" vertex="1">
          <mxGeometry x="800" y="350" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="robot-events&#xa;(결과/이벤트)" vertex="1">
          <mxGeometry x="800" y="470" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- ROS2 nodes -->
        <mxCell id="r1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="sfarm_bridge&#xa;(SQS ↔ ROS 2 Action Bridge Node)" vertex="1">
          <mxGeometry x="1100" y="280" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" value="sfarm_robot Action Servers&#xa;(Load1/Load2/Unload1/Unload2&#xa;/Jog/Gripper)" vertex="1">
          <mxGeometry x="1100" y="390" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- Hardware nodes -->
        <mxCell id="h1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="두산 M0609 로봇팔&#xa;(DSR_ROBOT2 API)" vertex="1">
          <mxGeometry x="1480" y="300" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="h2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="OnRobot RG2 그리퍼" vertex="1">
          <mxGeometry x="1480" y="375" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- ===================== Edges ===================== -->

        <!-- Frontend internal -->
        <mxCell id="e1" edge="1" parent="1" source="f1" target="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Frontend <-> Backend: routed through the empty F/B gap (x 300-380), never crossing f1 -->
        <mxCell id="e3" edge="1" parent="1" source="f2" target="b1" value="REST&#xa;(HTTP/JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;strokeColor=#1f78b4;fontColor=#1f78b4;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="298" />
              <mxPoint x="340" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="b2" target="f2" value="WebSocket Push&#xa;(상태 갱신)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#1f78b4;fontColor=#1f78b4;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.7;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="355" y="412" />
              <mxPoint x="355" y="343" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Backend internal chain -->
        <mxCell id="e5" edge="1" parent="1" source="b1" target="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="b3" target="b4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="b4" target="b2" value="상태 갱신" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Service -> DB, bumped out to the right of the whole backend column so it never crosses b4 -->
        <mxCell id="e6" edge="1" parent="1" source="b3" target="b6" value="Repository Layer&#xa;(CRUD)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="745" y="230" />
              <mxPoint x="745" y="412" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Backend <-> SQS -->
        <mxCell id="e10" edge="1" parent="1" source="b4" target="s1" value="produce&#xa;(작업 명령)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d79b00;fontColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" edge="1" parent="1" source="b4" target="s2" value="produce (STOP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d79b00;fontColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- events queue -> SQS service, bumped left of the SQS column so it never crosses s1/s2 -->
        <mxCell id="e12" edge="1" parent="1" source="s3" target="b4" value="consume&#xa;(polling)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d79b00;fontColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="775" y="502" />
              <mxPoint x="775" y="322" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- SQS <-> ROS2 bridge -->
        <mxCell id="e13" edge="1" parent="1" source="s1" target="r1" value="long polling&#xa;(20s)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d79b00;fontColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;entryX=0;entryY=0.3;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" edge="1" parent="1" source="s2" target="r1" value="short polling&#xa;(5s, 독립 스레드)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d79b00;fontColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.6;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- bridge -> events queue, bumped left of the R/S gap so it never crosses s1/s2 -->
        <mxCell id="e15" edge="1" parent="1" source="r1" target="s3" value="produce&#xa;(결과 이벤트)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d79b00;fontColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.6;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1060" y="331" />
              <mxPoint x="1060" y="502" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Bridge <-> robot action server -->
        <mxCell id="e16" edge="1" parent="1" source="r1" target="r2" value="ROS 2 Action/Service&#xa;load1,2·unload1,2&#xa;jog·gripper&#xa;error·jog/stop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;strokeColor=#9673a6;fontColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- robot server <-> hardware -->
        <mxCell id="e17" edge="1" parent="1" source="r2" target="h1" value="DSR_ROBOT2 호출" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;fontColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.6;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" edge="1" parent="1" source="r2" target="h2" value="그리퍼 제어" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;fontColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.4;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
